# Copie para .env.production antes de gerar os arquivos de producao.
# Use a URL publica real, sem barra no final.
VITE_PUBLIC_APP_ORIGIN=https://app.brainfyos.com.br

# Por padrao, o navegador usa a mesma origem e o proxy reverso encaminha a API.
VITE_FORCE_ABSOLUTE_API=false

# Identidade da sua instalacao. Troque tambem os SVGs em public/branding/.
VITE_APP_NAME=BrainfyOS
VITE_APP_DESCRIPTION=Infraestrutura de IA
VITE_SUPPORT_NAME=Equipe BrainfyOS
VITE_SUPPORT_EMAIL=suporte@brainfyos.com.br
